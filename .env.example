# Model provider: set ONE of these keys (Anthropic is used if both are set, unless MODEL_PROVIDER says otherwise).
ANTHROPIC_API_KEY=
# Gemini: https://aistudio.google.com/apikey  (GOOGLE_GENERATIVE_AI_API_KEY also works)
GEMINI_API_KEY=
# Groq (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=

# Optional: force a provider: anthropic | google | groq
# MODEL_PROVIDER=

# Required: primary web search. https://exa.ai
EXA_API_KEY=

# Optional: fallback web search, used if Exa fails or is unset. https://brave.com/search/api
BRAVE_API_KEY=

# Optional: Exa search mode (lite = fastest, auto = balanced).
# EXA_SEARCH_TYPE=lite

# Optional: override the models. Defaults:
#   anthropic: claude-haiku-5-5 (fast) / claude-sonnet-5-5 (answers)
#   google:    gemini-flash-lite-latest (fast) / gemini-3.5-flash (answers)
#   groq:      openai/gpt-oss-20b (fast) / openai/gpt-oss-120b (answers), with smaller prompts for the free plan
# FAST_MODEL=
# ANSWER_MODEL=

# Optional: freeze "now" (ISO 8601) to time-travel when testing memory, e.g. 2026-11-11T10:00:00+05:30
# NOW=

# Optional: where memory lives (default ./data/memory.db) and the API port (default 8787).
# DB_PATH=./data/memory.db
# API_PORT=8787
